{
  "name": "codebase-understanding-backend",
  "version": "1.0.0",
  "description": "NestJS backend for the Codebase Understanding Platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.540.0",
    "@aws-sdk/client-s3": "3.540.0",
    "@aws-sdk/s3-request-presigner": "3.540.0",
    "@nestjs/common": "10.3.3",
    "@nestjs/config": "3.2.0",
    "@nestjs/core": "10.3.3",
    "@nestjs/mongoose": "10.0.4",
    "@nestjs/platform-express": "10.3.3",
    "adm-zip": "0.5.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "mongoose": "8.2.1",
    "multer": "1.4.5-lts.1",
    "reflect-metadata": "0.2.1",
    "rxjs": "7.8.1",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.3",
    "@types/adm-zip": "0.5.5",
    "@types/jest": "29.5.12",
    "@types/multer": "1.4.11",
    "@types/node": "20.11.5",
    "@types/uuid": "9.0.7",
    "fast-check": "3.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}
